<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/overlay_card_bg"
    android:padding="12dp">

    <!-- Drag handle / header row -->
    <LinearLayout
        android:id="@+id/dragHandle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FF Switcher"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/white"
            android:background="@drawable/btn_grey_rounded" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtCounter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Account 1/1"
        android:textColor="@color/white"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/txtUid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="UID: -"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textIsSelectable="true" />

    <TextView
        android:id="@+id/txtPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Password: -"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textIsSelectable="true" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="..."
        android:textColor="#B0FFFFFF"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/btnPrevious"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="Previous"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:background="@drawable/btn_red_rounded" />

        <TextView
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="Next"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:background="@drawable/btn_green_rounded" />
    </LinearLayout>

</LinearLayout>
